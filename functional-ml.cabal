cabal-version:      3.0
name:               functional-ml
version:            0.1.0.0
synopsis:           A purely functional machine learning and automatic differentiation library in Haskell
description:        Demonstrates forward-mode (dual numbers) and reverse-mode (computational DAG)
                    automatic differentiation, functional neural network layers, optimizers, and
                    zero-copy Storable FFI kernels.
license:            MIT
author:             Girik Setya
category:           Machine Learning, Functional Programming
build-type:         Simple

common common-options
    default-language:   GHC2021
    ghc-options:        -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Wno-unused-do-bind -Wno-x-partial
    build-depends:      base >= 4.14 && < 5
                      , containers >= 0.6
                      , mtl >= 2.2
                      , array >= 0.5

library
    import:             common-options
    hs-source-dirs:     src
    c-sources:          cbits/kernels.c
    include-dirs:       cbits
    cc-options:         -O3 -ffast-math -Wall
    exposed-modules:    FunctionalML
                      , FunctionalML.Core
                      , FunctionalML.Autograd.Dual
                      , FunctionalML.Autograd.Reverse
                      , FunctionalML.NN.Layers
                      , FunctionalML.NN.Loss
                      , FunctionalML.NN.Optim
                      , FunctionalML.Tensor.Storable

executable functional-ml-demo
    import:             common-options
    hs-source-dirs:     app
    main-is:            Main.hs
    build-depends:      functional-ml
    ghc-options:        -threaded -rtsopts -with-rtsopts=-N

benchmark functional-ml-bench
    import:             common-options
    type:               exitcode-stdio-1.0
    hs-source-dirs:     bench
    main-is:            Main.hs
    build-depends:      functional-ml
    ghc-options:        -O2 -threaded -rtsopts -with-rtsopts=-N
